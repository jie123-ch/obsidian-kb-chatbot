# DeepSeek（用户自备 BYOK，https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 多人/联网部署的共享访问令牌（必填！否则任何人都能用你的 DeepSeek 额度）
# 建议用强随机值，例如：python -c "import secrets;print(secrets.token_urlsafe(24))"
SERVER_TOKEN=


# 知识库
VAULT_PATH=C:\Users\YourName\Documents\MyBrain
EXCLUDE_DIRS=.obsidian,.copilot,.agents,.claude,.opencode,copilot

# 嵌入模型（本地运行，笔记不上传）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 索引 / 检索参数
INDEX_DB=kb.db
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=3
# 相似度阈值：低于此分视为噪声来源（徐州地铁 0.481 在此被砍）
MIN_SCORE=0.49
